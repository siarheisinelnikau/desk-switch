<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Desk Switch</vendor>
  <vendor_url>https://github.com/siarheisinelnikau/desk-switch</vendor_url>
  <action id="com.deskswitch.input-access">
    <description>Remember Desk Switch access to selected input devices</description>
    <message>Share only the selected physical keyboard and mouse in the active desktop session.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/desk-switch/input-access</annotate>
  </action>
</policyconfig>
