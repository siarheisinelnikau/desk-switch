#!/bin/sh
set -eu
if [ "$(id -u)" -eq 0 ]; then
    echo 'Run Desk Switch as your desktop user, without sudo' >&2
    exit 1
fi
launcher=$(readlink -f -- "$0")
application=$(dirname -- "$(dirname -- "$launcher")")/lib/desk-switch/desk-switch
export DESK_SWITCH_PACKAGED_LAUNCHER="$launcher"
exec "$application" "$@"
