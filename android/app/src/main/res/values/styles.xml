<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#4BC4F4</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#0D1219</item>
        <item name="android:navigationBarColor">#0D1219</item>
        <item name="android:windowBackground">#0D1219</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="LightAppThemeBase" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#0C658F</item>
        <item name="android:colorBackgroundFloating">#FFFFFF</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F4F6FA</item>
        <item name="android:windowBackground">#F4F6FA</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="LightAppTheme" parent="LightAppThemeBase">
        <item name="android:navigationBarColor">#0D1219</item>
    </style>
</resources>
